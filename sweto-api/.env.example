APP_NAME=SWETO API
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
DEBUG=true

API_V1_PREFIX=/api/v1

POSTGRES_USER=sweto
POSTGRES_PASSWORD=sweto_dev_password
POSTGRES_DB=sweto

DATABASE_URL=postgresql+asyncpg://sweto:sweto_dev_password@localhost:5432/sweto
DATABASE_ECHO=false

OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=replace-with-a-long-random-jwt-secret
DEFAULT_PHONE_REGION=KE

# console logs codes and is refused in staging/production.
SMS_PROVIDER=console
SMS_SEND_TIMEOUT_SECONDS=10

# Countries whose numbers can sign in (JSON list of ISO codes). Codes go by
# SMS to OTP_SMS_REGIONS and on WhatsApp to every other supported country.
OTP_SUPPORTED_REGIONS=["KE","UG","TZ","RW","BI","SS","CD","SO"]
OTP_SMS_REGIONS=["KE"]
# disabled (default), console or meta. console logs codes: local, development
# and testing only; staging and production refuse to start with it.
WHATSAPP_PROVIDER=console
WHATSAPP_SEND_TIMEOUT_SECONDS=10

# Meta WhatsApp Cloud API, used when WHATSAPP_PROVIDER=meta. Secrets go in the
# deployment's secret store, never in this file or the repository. See
# docs/whatsapp-otp.md for where each value comes from.
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_OTP_TEMPLATE_NAME=
META_WHATSAPP_OTP_TEMPLATE_LANGUAGE=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINUTES=30
REFRESH_TOKEN_EXPIRY_DAYS=30

SESSION_ACTIVITY_UPDATE_INTERVAL_SECONDS=300

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=sweto

OTP_REQUEST_PHONE_LIMIT=5
OTP_REQUEST_PHONE_WINDOW_SECONDS=900

OTP_REQUEST_IP_LIMIT=20
OTP_REQUEST_IP_WINDOW_SECONDS=3600

OTP_VERIFY_CHALLENGE_LIMIT=10
OTP_VERIFY_CHALLENGE_WINDOW_SECONDS=900

OTP_VERIFY_IP_LIMIT=30
OTP_VERIFY_IP_WINDOW_SECONDS=900

PASSWORD_LOGIN_EMAIL_LIMIT=5
PASSWORD_LOGIN_EMAIL_WINDOW_SECONDS=900
PASSWORD_LOGIN_IP_LIMIT=20
PASSWORD_LOGIN_IP_WINDOW_SECONDS=900

SWETO_SUPER_ADMIN_EMAIL=
SWETO_SUPER_ADMIN_PASSWORD=

AWS_REGION=af-south-1
AWS_S3_UPLOADS_BUCKET=
AWS_S3_PRESIGNED_UPLOAD_EXPIRY_SECONDS=300
AWS_S3_PRESIGNED_DOWNLOAD_EXPIRY_SECONDS=300
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
