# /etc/sweto/backup.env (root only: chmod 600). Read by sweto-backup.
# Never commit a filled-in copy.

# age public key ("age1..."). Its private key stays OFFLINE with the owner
# (password manager); only it can open a backup.
AGE_RECIPIENT=

# Where backups are copied, as an rclone remote. With the Contabo settings
# below this is "contabo:<bucket>", e.g. contabo:sweto-backups.
BACKUP_REMOTE=contabo:sweto-backups

# rclone remote "contabo", configured from the environment (no rclone.conf).
RCLONE_CONFIG_CONTABO_TYPE=s3
RCLONE_CONFIG_CONTABO_PROVIDER=Other
RCLONE_CONFIG_CONTABO_ENDPOINT=https://eu2.contabostorage.com
RCLONE_CONFIG_CONTABO_ACCESS_KEY_ID=
RCLONE_CONFIG_CONTABO_SECRET_ACCESS_KEY=
RCLONE_CONFIG_CONTABO_ACL=private

# Optional (defaults shown).
# CONFIG_DIR=/srv/sweto/config
# BACKUP_ROOT=/var/backups/sweto
# KEEP_LOCAL_DAYS=14
# KEEP_REMOTE_DAYS=30
