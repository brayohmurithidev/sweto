APP_NAME=SWETO API
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
DEBUG=true

API_V1_PREFIX=/api/v1

POSTGRES_USER=sweto
POSTGRES_PASSWORD=sweto_dev_password
POSTGRES_DB=sweto

DATABASE_URL=postgresql+asyncpg://sweto:sweto_dev_password@localhost:5432/sweto
DATABASE_ECHO=false

OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=replace-with-a-long-random-jwt-secret
DEFAULT_PHONE_REGION=KE

SMS_PROVIDER=console

JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINUTES=30
REFRESH_TOKEN_EXPIRY_DAYS=30

SESSION_ACTIVITY_UPDATE_INTERVAL_SECONDS=300

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=sweto

OTP_REQUEST_PHONE_LIMIT=5
OTP_REQUEST_PHONE_WINDOW_SECONDS=900

OTP_REQUEST_IP_LIMIT=20
OTP_REQUEST_IP_WINDOW_SECONDS=3600

OTP_VERIFY_CHALLENGE_LIMIT=10
OTP_VERIFY_CHALLENGE_WINDOW_SECONDS=900

OTP_VERIFY_IP_LIMIT=30
OTP_VERIFY_IP_WINDOW_SECONDS=900

PASSWORD_LOGIN_EMAIL_LIMIT=5
PASSWORD_LOGIN_EMAIL_WINDOW_SECONDS=900
PASSWORD_LOGIN_IP_LIMIT=20
PASSWORD_LOGIN_IP_WINDOW_SECONDS=900

SWETO_SUPER_ADMIN_EMAIL=
SWETO_SUPER_ADMIN_PASSWORD=
